# Sao chép thành .env khi chạy máy cá nhân (KHÔNG commit .env)
DATABASE_URL=            # để trống = dùng SQLite data/ctv.db; Postgres: postgresql://user:pass@host/db?sslmode=require
ADMIN_PASSWORD=          # mật khẩu tài khoản admin khi khởi tạo DB mới
CRON_KEY=                # khoá bí mật cho /api/cron/tick (cron-job.org gọi)
HANDBOOK_SHEET_ID=       # mặc định cho Cẩm nang (có thể đặt trong Quản trị → Cẩm nang)
OPS_SHEET_ID=            # chỉ dùng cho lệnh import_sheet
PAYROLL_SHEET_ID=        # sheet bảng lương / tab Lịch trực (import_timesheet, đẩy lịch)
